#!/bin/sh
# Lets only Cloudflare's edge open connections to the web ports (80, 443).
# IPv4 reaches Caddy through Docker's DNAT (FORWARD, so DOCKER-USER); IPv6 has
# no DNAT and reaches docker-proxy through INPUT. Both jump to one chain that
# returns for Cloudflare ranges and drops the rest. The last good list is kept,
# so a failed download never opens or empties the filter.
set -eu

dir=/var/lib/cloudflare-ips
# The public interface: the one holding the default route, unless CF_IFACE is set.
iface=${CF_IFACE:-$(ip -o route show default | awk '{print $5; exit}')}
[ -n "$iface" ] || { echo "cloudflare-origin-firewall: no default-route interface" >&2; exit 1; }
mkdir -p "$dir"

for v in 4 6; do
  if curl -fsS --max-time 20 "https://www.cloudflare.com/ips-v$v" -o "$dir/v$v.new" \
    && [ -s "$dir/v$v.new" ] && ! grep -Eqv '^[0-9a-f.:]+/[0-9]+$' "$dir/v$v.new"; then
    mv "$dir/v$v.new" "$dir/v$v"
  else
    echo "cloudflare-origin-firewall: keeping the previous v$v list" >&2
  fi
  rm -f "$dir/v$v.new"
  [ -s "$dir/v$v" ] || { echo "cloudflare-origin-firewall: no v$v list" >&2; exit 1; }
done

# The new list is built in a side chain and swapped in, so the ports are never
# left unfiltered and a failure midway keeps the rules already in force.
apply() {
  ipt=$1 list=$2 next=CLOUDFLARE-NEXT
  "$ipt" -F "$next" 2>/dev/null && "$ipt" -X "$next"
  "$ipt" -N "$next"
  # The lists have no trailing newline; `|| [ -n "$net" ]` keeps the last range.
  while read -r net || [ -n "$net" ]; do
    "$ipt" -A "$next" -s "$net" -j RETURN
  done < "$list"
  # Logged to /var/log/ufw.log by ufw's rsyslog rule (it matches "[UFW "), rate-limited.
  "$ipt" -A "$next" -m limit --limit 10/min --limit-burst 20 -j LOG --log-prefix "[UFW CF-BLOCK] "
  "$ipt" -A "$next" -j DROP
  "$ipt" -N DOCKER-USER 2>/dev/null || true
  match="-i $iface -p tcp -m multiport --dports 80,443 -m conntrack --ctstate NEW -j"
  for chain in DOCKER-USER INPUT; do
    # shellcheck disable=SC2086
    "$ipt" -I "$chain" 1 $match "$next"
    # shellcheck disable=SC2086
    while "$ipt" -D "$chain" $match CLOUDFLARE-ONLY 2>/dev/null; do :; done
  done
  "$ipt" -F CLOUDFLARE-ONLY 2>/dev/null && "$ipt" -X CLOUDFLARE-ONLY
  "$ipt" -E "$next" CLOUDFLARE-ONLY
}

apply iptables "$dir/v4"
apply ip6tables "$dir/v6"
