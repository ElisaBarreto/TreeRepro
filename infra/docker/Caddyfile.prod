{
	servers {
		# Production sits behind the Cloudflare proxy, and the host firewall lets
		# only Cloudflare reach 80/443 (infra/host/). From these peers the client
		# is CF-Connecting-IP; from any other peer it is the remote address
		# (RFC-22 R12). Ranges: https://www.cloudflare.com/ips/ (checked 2026-09-25).
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

{$DOMAIN} {
	encode zstd gzip

	# Access log for incident investigation (RFC-02 R7): JSON with the resolved
	# client IP, rolled daily; rolled files over 30 days old go at the next roll
	# (Caddy prunes only when it writes). On the caddy-logs volume. Caddy already redacts
	# Cookie, Set-Cookie and Authorization; the tokens in the SPA's invitation
	# and password-reset URLs (and Referers) are masked here.
	log {
		output file /var/log/caddy/access.log {
			roll_size 50MiB
			roll_interval 24h
			roll_keep 1000
			roll_keep_for 720h
		}
		format filter {
			wrap json
			fields {
				request>uri regexp ^/(invite|reset-password)/[^/?#]+ /${1}/REDACTED
				# Same-origin requests from those pages carry the full URL as Referer.
				request>headers>Referer regexp /(invite|reset-password)/[^/?#]+ /${1}/REDACTED
			}
		}
	}

	# Site level so `/api/*` responses carry them too (RFC-02 R5). The block is
	# deferred (it contains a deletion), so these values replace the API's own
	# overlapping headers (1-year HSTS wins over Hono's default).
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}

	route {
		@ready path /api/health/ready
		respond @ready 404

		handle /api/* {
			# One value, the resolved client (RFC-22 R12). Caddy's default would
			# append the Cloudflare edge after a trusted incoming chain.
			reverse_proxy api:3000 {
				header_up X-Forwarded-For {client_ip}
			}
		}

		handle {
			root * /srv/web
			try_files {path} /index.html
			file_server
			# The SPA CSP; API responses keep Hono's `default-src 'none'` (RFC-02 R5).
			header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		}
	}
}
