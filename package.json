{
  "name": "treerepro",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "sh scripts/e2e.sh",
    "build": "pnpm -r build",
    "rfc:check": "pnpm --filter @treerepro/rfc-lint check",
    "seed:admin": "pnpm --filter @treerepro/api seed:admin",
    "seed:traits": "pnpm --filter @treerepro/api seed:traits",
    "import:records": "pnpm --filter @treerepro/api import:records"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "24.13.4",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
