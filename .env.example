# Copy to .env. Compose reads COMPOSE_FILE to pick the overrides.
COMPOSE_FILE=compose.yml:compose.dev.yml

# Origin the browser uses; the API rejects mutations from any other origin (RFC-02 R3).
# Development only — this is also the compose.yml default. In production compose.prod.yml
# derives it from DOMAIN and ignores this variable.
APP_ORIGIN=http://localhost
LOG_LEVEL=debug
PII_CURRENT_KEY_VERSION=v1
DOI_CONTACT_EMAIL=
# WCVP dataset key on GBIF (RFC-81 R1); unset skips the WCVP lookup and the
# verdict comes from the GBIF backbone alone. Checked live 2026-09-19.
WCVP_GBIF_DATASET_KEY=f382f0ce-323a-4091-bb9f-add557f3a9a2
# Set to false to stop the daily digest e-mail (RFC-74 R6); unset means on.
# DIGEST_ENABLED=true

# Production only (compose.prod.yml). DOMAIN drives both Caddy and APP_ORIGIN (https://$DOMAIN).
# COMPOSE_FILE=compose.yml:compose.prod.yml
# DOMAIN=treerepro.example.org
# BACKUP_AGE_RECIPIENT=age1...
# BACKUP_PING_URL=https://hc-ping.com/...   # optional dead man's switch, hit after each successful backup (docs/gotchas/infra.md)
# Outbound mail: compose.prod.yml runs a send-only Postfix relay (`mail`) and points the
# API at it; the DNS records it needs are in docs/gotchas/infra.md.
# MAIL_DOMAIN=example.org
# MAIL_HOSTNAME=mail.example.org
# SMTP_FROM=TreeRepro <noreply@example.org>
# To send through an external provider instead, set SMTP_HOST and the lines below
# (the relay keeps running and needs MAIL_* regardless).
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=mailer          # leave unset when the server needs no authentication
