exports[`RFC-13 R14 Emblem per platform > draws the tree for TreeRepro and the forest for PlantRepro > plantrepro 1`] = `"<svg viewBox="0 0 200 200" width="40" height="40" role="img" aria-label="PlantRepro emblem: a tree in fruit among a conifer, a flower, a fern and grass"><title>PlantRepro emblem: a tree in fruit among a conifer, a flower, a fern and grass</title><defs><radialGradient id="_r_5_disc" cx="38%" cy="30%" r="80%"><stop offset="0%" stop-color="#c060a3"></stop><stop offset="60%" stop-color="#74225c"></stop><stop offset="100%" stop-color="#2a0b21"></stop></radialGradient><radialGradient id="_r_5_c1" cx="35%" cy="30%" r="75%"><stop offset="0%" stop-color="#3faa86"></stop><stop offset="100%" stop-color="#1b6b57"></stop></radialGradient><radialGradient id="_r_5_c2" cx="35%" cy="30%" r="75%"><stop offset="0%" stop-color="#7ccf9f"></stop><stop offset="100%" stop-color="#2f9d7c"></stop></radialGradient><radialGradient id="_r_5_c3" cx="35%" cy="30%" r="75%"><stop offset="0%" stop-color="#b5ebc9"></stop><stop offset="100%" stop-color="#5fbf8a"></stop></radialGradient><linearGradient id="_r_5_trunk" x1="0" y1="0" x2="1" y2="0"><stop offset="0%" stop-color="#8a5426"></stop><stop offset="55%" stop-color="#c1863f"></stop><stop offset="100%" stop-color="#8a5426"></stop></linearGradient><radialGradient id="_r_5_fruit" cx="35%" cy="35%" r="70%"><stop offset="0%" stop-color="#ffd777"></stop><stop offset="100%" stop-color="#e8a33d"></stop></radialGradient></defs><circle cx="100" cy="100" r="96" fill="url(#_r_5_disc)"></circle><circle cx="100" cy="100" r="96" fill="none" stroke="rgba(255,255,255,0.14)" stroke-width="1.5"></circle><path d="M40 150 Q100 136 160 150" fill="none" stroke="rgba(255,255,255,0.12)" stroke-width="2" stroke-linecap="round"></path><g><rect x="47" y="132" width="7" height="20" rx="2" fill="#8a5426"></rect><path d="M50 56 L33 92 H67 Z" fill="#2f9d7c"></path><path d="M50 74 L28 114 H72 Z" fill="#1f8f7a"></path><path d="M50 94 L24 136 H76 Z" fill="#1b6b5