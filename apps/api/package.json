{
  "name": "@treerepro/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --conditions=development src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config ../../vitest.config.ts --project api:unit --project api:integration",
    "test:unit": "vitest run --config ../../vitest.config.ts --project api:unit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --conditions=development src/db/migrate.ts",
    "seed:admin": "node --conditions=development src/cli/seed-admin.ts",
    "seed:traits": "node --conditions=development src/cli/seed-traits.ts",
    "import:records": "node --conditions=development src/cli/import-records.ts",
    "import:species-status": "node --conditions=development src/cli/import-species-status.ts",
    "import:plots": "node --conditions=development src/cli/import-plots.ts",
    "import:plot-species": "node --conditions=development src/cli/import-plot-species.ts",
    "import:user-plots": "node --conditions=development src/cli/import-user-plots.ts",
    "import:synonyms": "node --conditions=development src/cli/import-synonyms.ts",
    "import:references": "node --conditions=development src/cli/import-references.ts",
    "prepare:imports": "node --conditions=development src/cli/prepare-imports.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@hono/zod-validator": "0.9.1",
    "@node-rs/argon2": "2.2.1",
    "@treerepro/contracts": "workspace:*",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.8",
    "ioredis": "6.0.0",
    "nodemailer": "10.0.10",
    "otpauth": "9.5.2",
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.1.0",
    "@testcontainers/redis": "12.1.0",
    "@treerepro/config": "workspace:*",
    "@types/node": "24.13.4",
    "drizzle-kit": "0.31.10",
    "fast-check": "4.10.1",
    "testcontainers": "12.1.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
